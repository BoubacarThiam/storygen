# Copie ce fichier en .env puis renseigne ta clé (gratuite) :
# 1. Crée un compte sur https://openrouter.ai/
# 2. Va dans "Keys" (https://openrouter.ai/keys) -> "Create Key"
# 3. Colle la clé ci-dessous (aucune carte bancaire requise pour les modèles :free)
OPENROUTER_API_KEY=

# Pollinations (images). Si tu vois une erreur 402 / besoin d'authentification,
# créer une clé gratuite sur https://enter.pollinations.ai/ et la renseigner ci-dessous.
STORYGEN_POLLINATIONS_API_KEY=
# STORYGEN_POLLINATIONS_BASE_URL=https://gen.pollinations.ai/image

# Optionnel : modèle faster-whisper utilisé pour les sous-titres.
# "tiny" le plus léger (idéal Render free), "base", "small" (défaut local), "medium", "large-v3"
# STORYGEN_WHISPER_MODEL=small

# Optionnel : animation / qualité / vitesse
# STORYGEN_ANIMATE=1
# STORYGEN_IMAGE_CONCURRENCY=3
# STORYGEN_IMAGE_STAGGER=0.6
# STORYGEN_MONTAGE_CRF=20
# STORYGEN_MONTAGE_FPS=30
# STORYGEN_MONTAGE_PRESET=veryfast
# STORYGEN_MONTAGE_AUDIO_BITRATE=128k
# STORYGEN_MONTAGE_UPSCALE=2
# STORYGEN_OUTPUT_SCALE=1.0
# STORYGEN_FFMPEG_THREADS=0
